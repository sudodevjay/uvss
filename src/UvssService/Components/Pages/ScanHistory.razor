@page "/scan-history"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using UvssService.Data
@using UvssService.Data.Entities
@using UvssService.Lanes
@inject IDbContextFactory<UvssDbContext> DbFactory
@inject ScanEventNotifier ScanEventNotifier
@implements IDisposable

<PageTitle>Scan History - UVSS</PageTitle>

<div class="p-4 max-w-[1400px] mx-auto">
    <div class="bg-white border border-[#ccc] rounded p-4 mb-4 flex flex-wrap items-end gap-4">
        <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-[#555]">License Plate</label>
            <input @bind="_plateFilter" @bind:event="oninput" placeholder="Search plate..."
                   class="border border-[#ccc] rounded px-2 py-1.5 text-sm w-48" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-[#555]">Admission Status</label>
            <select @bind="_admissionFilter" class="border border-[#ccc] rounded px-2 py-1.5 text-sm w-40">
                <option value="">All Statuses</option>
                <option value="Approved">Approved</option>
                <option value="Pending">Pending</option>
                <option value="Denied">Denied</option>
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-[#555]">Start Date</label>
            <input type="date" @bind="_startDate" class="border border-[#ccc] rounded px-2 py-1.5 text-sm" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-[#555]">End Date</label>
            <input type="date" @bind="_endDate" class="border border-[#ccc] rounded px-2 py-1.5 text-sm" />
        </div>
        <button class="bg-[#1a5fb4] text-white px-4 py-1.5 rounded text-sm font-semibold cursor-pointer" @onclick="() => StateHasChanged()">Apply Filters</button>
        <button class="bg-[#e2e2e2] text-[#333] px-4 py-1.5 rounded text-sm font-semibold cursor-pointer" @onclick="ClearFilters">Clear</button>
    </div>

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="bg-[#fbe1db] border border-[#c23b1f] text-[#c23b1f] rounded p-3 text-sm mb-4">@_loadError</div>
    }

    <div class="bg-white border border-[#ccc] rounded overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-[#ececec] border-b border-[#ccc]">
                    <tr class="text-left text-[#555] text-xs uppercase tracking-wide">
                        <th class="p-3">ID</th>
                        <th class="p-3">Inspection Timestamp</th>
                        <th class="p-3">License Plate</th>
                        <th class="p-3">Driver Identification</th>
                        <th class="p-3">Threat Scan</th>
                        <th class="p-3">Admission</th>
                        <th class="p-3">Scan Dossier Notes</th>
                        <th class="p-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in FilteredEntries)
                    {
                        <tr class="border-b border-[#eee] hover:bg-[#fafafa]">
                            <td class="p-3 text-[#777]">#@entry.Id</td>
                            <td class="p-3 whitespace-nowrap">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="p-3 font-bold text-[#1a5fb4]">@(string.IsNullOrEmpty(entry.PlateText) ? "-" : entry.PlateText)</td>
                            <td class="p-3">@entry.DriverName</td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded text-xs font-bold @(entry.ForeignObjectDetected ? "bg-[#fbe1db] text-[#c23b1f]" : "bg-[#dff2df] text-[#2c7a2c]")">
                                    @(entry.ForeignObjectDetected ? "Threat" : "Clean")
                                </span>
                            </td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded text-xs font-bold @AdmissionBadgeClass(entry.Admission)">@entry.Admission</span>
                            </td>
                            <td class="p-3 text-[#555] max-w-[260px] truncate" title="@entry.DossierNotes">@entry.DossierNotes</td>
                            <td class="p-3">
                                <button class="bg-[#c23b1f] text-white px-3 py-1 rounded text-xs font-semibold cursor-pointer" @onclick="() => Delete(entry.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                    @if (FilteredEntries.Count == 0)
                    {
                        <tr><td colspan="8" class="p-6 text-center text-[#777]">No scan history matches these filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _plateFilter = "";
    private string _admissionFilter = "";
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _loadError = "";

    /// <summary>Loaded from MySQL (see ScanEvent) rather than an in-memory
    /// store -- reloaded on init and whenever ScanEventNotifier fires, so
    /// this page still updates live without polling.</summary>
    private List<ScanEvent> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        ScanEventNotifier.Changed += OnChanged;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _entries = await db.ScanEvents.OrderByDescending(e => e.Id).Take(500).ToListAsync();
            _loadError = "";
        }
        catch (Exception ex)
        {
            _loadError = $"Could not reach the scan history database (is MySQL running?): {ex.Message}";
        }
    }

    private void OnChanged() => _ = InvokeAsync(async () => { await LoadEntries(); StateHasChanged(); });

    private List<ScanEvent> FilteredEntries =>
        _entries
            .Where(e => string.IsNullOrWhiteSpace(_plateFilter) || e.PlateText.Contains(_plateFilter, StringComparison.OrdinalIgnoreCase))
            .Where(e => string.IsNullOrEmpty(_admissionFilter) || e.Admission.ToString() == _admissionFilter)
            .Where(e => _startDate == null || e.Timestamp.Date >= _startDate.Value.Date)
            .Where(e => _endDate == null || e.Timestamp.Date <= _endDate.Value.Date)
            .ToList();

    private void ClearFilters()
    {
        _plateFilter = "";
        _admissionFilter = "";
        _startDate = null;
        _endDate = null;
    }

    private async Task Delete(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ScanEvents.FindAsync(id);
        if (entity != null) { db.ScanEvents.Remove(entity); await db.SaveChangesAsync(); }
        await LoadEntries();
    }

    private static string AdmissionBadgeClass(AdmissionStatus status) => status switch
    {
        AdmissionStatus.Approved => "bg-[#dff2df] text-[#2c7a2c]",
        AdmissionStatus.Denied => "bg-[#fbe1db] text-[#c23b1f]",
        _ => "bg-[#fdf1d8] text-[#b0700a]",
    };

    public void Dispose() => ScanEventNotifier.Changed -= OnChanged;
}
