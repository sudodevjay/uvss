@page "/vehicle-registry"
@rendermode InteractiveServer
@using UvssService.Lanes
@inject VehicleRegistryStore VehicleRegistryStore
@implements IDisposable

<PageTitle>Vehicle Registry - UVSS</PageTitle>

<div class="p-4 max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-4 items-start">
    <div class="bg-white border border-[#ccc] rounded p-4">
        <h2 class="text-sm font-bold tracking-wide text-[#222] mb-3">ADD NEW VEHICLE</h2>
        <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-[#555]">License Plate <span class="text-[#c23b1f]">*</span></label>
                <input @bind="_plate" @bind:event="oninput" placeholder="E.G. ABC-1234" class="border border-[#ccc] rounded px-2 py-1.5 text-sm" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-[#555]">Owner Name / Designation</label>
                <input @bind="_owner" placeholder="e.g. Ahmed Khan (CEO)" class="border border-[#ccc] rounded px-2 py-1.5 text-sm" />
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-[#555]">Access Classification <span class="text-[#c23b1f]">*</span></label>
                <select @bind="_classification" class="border border-[#ccc] rounded px-2 py-1.5 text-sm">
                    <option value="Whitelist">Whitelist (Auto-Approve)</option>
                    <option value="Normal">Normal</option>
                    <option value="Blacklist">Blacklist (Deny)</option>
                </select>
            </div>
            <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-[#555]">Dossier / Clearance Notes</label>
                <textarea @bind="_notes" rows="3" placeholder="Enter vehicle details, clearance details or security reasons..."
                          class="border border-[#ccc] rounded px-2 py-1.5 text-sm resize-none"></textarea>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="text-xs text-[#c23b1f] font-semibold">@_error</p>
            }
            <button class="bg-[#1a5fb4] text-white rounded py-2 text-sm font-semibold cursor-pointer" @onclick="Save">Save Vehicle Record</button>
        </div>
    </div>

    <div class="bg-white border border-[#ccc] rounded p-4">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
            <h2 class="text-sm font-bold tracking-wide text-[#222]">VEHICLE CLASSIFICATION LIST</h2>
            <div class="flex items-center gap-2">
                <input @bind="_search" @bind:event="oninput" placeholder="Search plates..." class="border border-[#ccc] rounded px-2 py-1.5 text-sm w-44" />
                <select @bind="_categoryFilter" class="border border-[#ccc] rounded px-2 py-1.5 text-sm">
                    <option value="">All Categories</option>
                    <option value="Whitelist">Whitelist</option>
                    <option value="Normal">Normal</option>
                    <option value="Blacklist">Blacklist</option>
                </select>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-[#ececec] border-b border-[#ccc]">
                    <tr class="text-left text-[#555] text-xs uppercase tracking-wide">
                        <th class="p-3">License Plate</th>
                        <th class="p-3">Owner / Designation</th>
                        <th class="p-3">Classification</th>
                        <th class="p-3">Clearance Dossier Notes</th>
                        <th class="p-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in FilteredEntries)
                    {
                        <tr class="border-b border-[#eee] hover:bg-[#fafafa]">
                            <td class="p-3 font-bold text-[#1a5fb4]">@entry.LicensePlate</td>
                            <td class="p-3">@entry.OwnerName</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded text-xs font-bold @ClassBadgeClass(entry.Classification)">@entry.Classification</span></td>
                            <td class="p-3 text-[#555] max-w-[280px] truncate" title="@entry.Notes">@entry.Notes</td>
                            <td class="p-3"><button class="bg-[#c23b1f] text-white px-3 py-1 rounded text-xs font-semibold cursor-pointer" @onclick="() => Remove(entry.Id)">Remove</button></td>
                        </tr>
                    }
                    @if (FilteredEntries.Count == 0)
                    {
                        <tr><td colspan="5" class="p-6 text-center text-[#777]">No vehicles registered yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _plate = "";
    private string _owner = "";
    private VehicleClassification _classification = VehicleClassification.Whitelist;
    private string _notes = "";
    private string _error = "";
    private string _search = "";
    private VehicleClassification? _categoryFilter;

    protected override void OnInitialized() => VehicleRegistryStore.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private List<VehicleRegistryEntry> FilteredEntries =>
        VehicleRegistryStore.All
            .Where(e => string.IsNullOrWhiteSpace(_search) || e.LicensePlate.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .Where(e => _categoryFilter == null || e.Classification == _categoryFilter)
            .ToList();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_plate))
        {
            _error = "License plate is required.";
            return;
        }
        VehicleRegistryStore.Add(_plate, _owner, _classification, _notes);
        _plate = "";
        _owner = "";
        _notes = "";
        _classification = VehicleClassification.Whitelist;
        _error = "";
    }

    private void Remove(long id) => VehicleRegistryStore.Remove(id);

    private static string ClassBadgeClass(VehicleClassification c) => c switch
    {
        VehicleClassification.Whitelist => "bg-[#dff2df] text-[#2c7a2c]",
        VehicleClassification.Blacklist => "bg-[#fbe1db] text-[#c23b1f]",
        _ => "bg-[#fdf1d8] text-[#b0700a]",
    };

    public void Dispose() => VehicleRegistryStore.Changed -= OnChanged;
}
