{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "_comment": "Lane Setup's storage (controllers/cameras) -- same local MySQL server anpr-multicam already uses on this machine (127.0.0.1:3306, root, no password), just a separate database so the two projects don't share tables.",
    "MySql": "Server=127.0.0.1;Port=3306;Database=uvss_service;User=root;Password=;"
  },

  "CameraDefaults": {
    "SnapshotPath": "/axis-cgi/jpg/image.cgi",
    "SnapshotResolution": "1920x1080",
    "SnapshotCompression": 10,
    "SnapshotTimeoutSeconds": 6,
    "LivePollIntervalMs": 400
  },

  "AreaScan": {
    "FrameWidthPx": 2048,
    "MaxFramesPerPass": 2000,
    "ReferenceRowsPerMetre": 500
  },

  "LoopSensorDefaults": {
    "DefaultPairDistanceMetres": 3.0,
    "MaxPassSeconds": 30
  },

  "FaceDetector": {
    "Enabled": true,
    "CascadePath": "weights/haarcascade_frontalface_default.xml",
    "TrackMaxFrames": 30
  },

  "ForeignObjectDetector": {
    "Enabled": true,
    "Method": "yolo",
    "ModelPath": "weights/foreign_object_detector.onnx",
    "Confidence": 0.45,
    "_comment": "SimulateForTesting is a dev-only switch -- no real trained model exists yet, so this fakes one detection every other pass to test the highlighted panel/Scan History/Analytics threat flows end-to-end. Set to false before anything resembling production.",
    "SimulateForTesting": true
  },

  "Storage": {
    "Enabled": true,
    "DriverImageDir": "captured_driver",
    "AnprImageDir": "captured_anpr",
    "UndervehicleImageDir": "captured_undervehicle"
  },

  "PlateDetector": {
    "Enabled": true,
    "ModelPath": "weights/plate_detector.onnx",
    "Confidence": 0.4
  },

  "PlateOcr": {
    "Enabled": true,
    "BackboneModelPath": "weights/ctc_backbone_and_head.onnx",
    "DecoderModelPath": "weights/sar_decoder_step.onnx",
    "EmbeddingPath": "weights/sar_embedding_99x512.bin",
    "CharDictPath": "weights/en_dict.txt",
    "AggregationEnabled": true,
    "TrackMaxFrames": 40,
    "AggregationWindowSize": 10,
    "AggregationMinCandidates": 7
  }
}
